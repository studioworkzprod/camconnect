{
  "expo": {
    "name": "Canon DSLR Companion",
    "slug": "canon-companion",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "canon-companion",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#151614"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.fieldlink.canoncompanion",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#151614"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": ["expo-router", "./plugins/withCanonUsb"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
